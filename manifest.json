{
  "manifest_version": 3,
  "name": "Superpixel",
  "version": "0.1.2",
  "description": "Competitor research: on-site marketing tags and running ads from public ad libraries for any domain.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Superpixel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "tabs", "scripting", "offscreen", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/ads/library/*"],
      "js": ["content/hook-main.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/ads/library/*"],
      "js": ["content/relay.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://library.tiktok.com/*"],
      "js": ["content/hook-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://library.tiktok.com/*"],
      "js": ["content/relay.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
